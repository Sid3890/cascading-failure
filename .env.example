# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# SQLite file location. The default is data/cascading_failure.db.
DATABASE_PATH=data/cascading_failure.db

# Optional: when set, every /api/v1 request (except OpenAPI) needs this header.
# API_KEY=replace-with-a-long-random-secret
